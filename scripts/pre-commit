#!/bin/bash
# Confere o snapshot staged para uma correção local não esconder um pacote inválido.
# Instalar: git config core.hooksPath scripts/
set -euo pipefail

snapshot=$(mktemp -d)
trap 'rm -rf -- "$snapshot"' EXIT
git diff --cached --name-only -z > "$snapshot/paths"
needs_validation=false
while IFS= read -r -d '' path; do
    case "$path" in
        plugins/*|.agents/plugins/*|.claude-plugin/*|install.py|scripts/codex-*.py|scripts/validate-versions.py|scripts/pre-commit|tests/test_codex_*.py)
            needs_validation=true ;;
    esac
done < "$snapshot/paths"

if "$needs_validation"; then
    echo '[pre-commit] Validando o conteúdo staged da distribuição...'
    git checkout-index --all --prefix="$snapshot/tree/"
    python3 "$snapshot/tree/scripts/validate-versions.py"
fi
